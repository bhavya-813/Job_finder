# Copy this file to ".env" if you switch to a jobs API that requires a key.
# The bundled Remotive API (used by default in src/services/jobsApi.js)
# does NOT require a key, so this is optional for the default setup.
#
# Vite only exposes environment variables to the browser if they are
# prefixed with VITE_ - that's why the variable is named VITE_JOBS_API_KEY.

VITE_JOBS_API_KEY=
